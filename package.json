{
    "name":  "dsh-snapshot-manager",
    "version":  "1.1.0",
    "private":  true,
    "type":  "module",
    "description":  "DeepSeek Harness 快照管家 —— 保存 / 回滚 / 差异对比",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-sidebar",
                                              "@deepseek-ai/dsh-client-ui-slots"
                                          ]
                           }
            },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "README.md",
                  "bin/WhaleSnapshot.exe"
              ]
}